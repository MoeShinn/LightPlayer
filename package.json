{
  "name": "light-player",
  "productName": "LightPlayer",
  "version": "1.1.0",
  "description": "Trinh xem video nhe dung HTML + Electron",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win dir --x64",
    "build:setup": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lightplayer.app",
    "productName": "LightPlayer",
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "assets/logo.png",
      "package.json"
    ],
    "electronLanguages": [
      "en-US",
      "vi"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "LightPlayer-Setup.exe"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mkv",
          "webm",
          "avi",
          "mov",
          "m4v"
        ],
        "name": "Video"
      }
    ]
  }
}
